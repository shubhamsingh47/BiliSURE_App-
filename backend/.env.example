# BiliSURE Production Environment Configuration Template
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas or Enterprise Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.bilisure.mongodb.net/bilisure?retryWrites=true&w=majority

# Cryptographic Token Keys (Use minimum 256-bit random secrets in production)
JWT_SECRET=your_production_jwt_secret_change_me_before_deploying
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_change_me_before_deploying
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cross-Origin Resource Sharing
CORS_ORIGIN=https://app.bilisure.district.org

# Logging & Monitoring
LOG_LEVEL=info
